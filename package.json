{
  "name": "head-draftsmen-app",
  "version": "1.6.0",
  "description": "Documentation made easy",
  "main": "out/main/index.js",
  "author": "Head Draughtsman App",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
